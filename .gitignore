# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dotfiles and dotfolders are ignored by default, so scratch directories stay out of
# the way. Everything that belongs in the repository is re-included below; a folder
# has to be re-included before its contents can be.
.*
!.gitignore
!.dockerignore
!.prettierrc
!.prettierignore
!.github/
!.husky/
!.devcontainer/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# runtime instance data (generated from DB)
/data/
/config/instances/

# production
/build

# misc
.DS_Store
*.pem

# local agent worktrees
/.kilo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
